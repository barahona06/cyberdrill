# Built application files
*.apk
*.aab
*.ap_
*.dex
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration (machine-specific)
/local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files (never commit signing keys)
*.jks
*.keystore

# Manual-build byproducts (dependencies and tool jars are re-resolved on demand)
app/libs/
manual-build/out/
manual-build/.pom-cache/
manual-build/tools/
manual-build/debug.keystore
__pycache__/

# OS files
.DS_Store
